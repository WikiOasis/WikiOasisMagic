		},
		"LocalFilePurgeThumbnails": {
			"handler": "CloudflarePurge"
		},
		"PageDeleteComplete": [
			"CloudflarePurge",
			"Onboarding"
		],
		"PageMoveComplete": {
			"handler": "CloudflarePurge"
		},
		"PageSaveComplete": [
			"CloudflarePurge",
			"Onboarding",
			"Experiments"
		],
		"ContributionsToolLinks": {
			"handler": "Main"
		},
		"CreateWikiCreation": [
			"Main",
			"Experiments"
		],
		"CreateWikiDeletion": {
			"handler": "CloudflarePurge"
		},
		"CreateWikiCreationExtraFields": {
