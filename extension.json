		]
	},
	"ExtensionMessagesFiles": {
		"WikiOasisMagicAliases": "WikiOasisMagicAliases.php"
	},
	"AutoloadNamespaces": {
		"WikiOasis\\WikiOasisMagic\\": "includes/",
		"WikiOasis\\WikiOasisMagic\\Jobs\\": "includes/Jobs/",
		"WikiOasis\\WikiOasisMagic\\Maintenance\\": "maintenance/"
	},
	"TestAutoloadNamespaces": {
		"WikiOasis\\WikiOasisMagic\\Tests\\": "tests/phpunit/"
	},
	"Hooks": {
