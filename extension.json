{
	"name": "WikiOasisMagic",
	"author": [
		"Agent Isai",
		"John Lewis",
		"Labster",
		"MacFan4000",
		"Reception123",
		"Revi",
		"Paladox",
		"Southparkfan",
		"Universal Omega",
		"Waki285",
        "Zippybonzo"
	],
	"url": "https://github.com/WikiOasis/WikiOasisMagic",
	"descriptionmsg": "wikioasismagic-description",
	"namemsg": "wikioasismagic-extensionname",
	"license-name": "GPL-3.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.45.0",
		"platform": {
			"php": ">= 8.0"
		}
	},
	"MessagesDirs": {
		"WikiOasisMagic": [
			"i18n/wikioasis"
		]
	},
	"AutoloadNamespaces": {
		"WikiOasis\\WikiOasisMagic\\": "includes/",
		"WikiOasis\\WikiOasisMagic\\Jobs\\": "includes/Jobs/",
		"WikiOasis\\WikiOasisMagic\\Maintenance\\": "maintenance/"
	},
	"Hooks": {
		"AbuseFilterShouldFilterAction": {
			"handler": "Main"
		},
		"ArticlePurge": {
			"handler": "CloudflarePurge"
		},
		"LocalFilePurgeThumbnails": {
			"handler": "CloudflarePurge"
		},
		"PageDeleteComplete": {
			"handler": "CloudflarePurge"
		},
		"PageMoveComplete": {
			"handler": "CloudflarePurge"
		},
		"PageSaveComplete": {
			"handler": "CloudflarePurge"
		},
        "BlockIpComplete": {
            "handler": "Main"
        },
		"ContributionsToolLinks": {
			"handler": "Main"
		},
		"CreateWikiCreation": {
			"handler": "Main"
		},
        "CreateWikiCreationExtraFields": {
            "handler": "RequestWiki"
        },
		"CreateWikiStatePrivate": {
			"handler": "Main"
		},
        "CreateWikiStatePublic": {
            "handler": "Main"
        },
		"CreateWikiTables": {
			"handler": "Main"
		},
		"GetLocalURL::Internal": {
			"handler": "Main"
		},
		"GlobalUserPageWikis": {
			"handler": "Main"
		},
        "ImportDumpJobGetFile": {
			"handler": "Main"
		},
		"MessageCacheFetchOverrides": {
			"handler": "Main"
		},
		"MimeMagicInit": {
			"handler": "Main"
		},
        "RequestWikiFormDescriptorModify": {
            "handler": "RequestWiki"
        },
        "RequestWikiQueueFormDescriptorModify": {
            "handler": "RequestWiki"
        },
		"SiteNoticeAfter": {
			"handler": "Main"
		},
		"SkinAddFooterLinks": {
			"handler": "Main"
		},
		"TitleReadWhitelist": {
			"handler": "Main"
		}
    },
	"HookHandlers": {
		"Main": {
			"class": "WikiOasis\\WikiOasisMagic\\HookHandlers\\Main",
			"factory": "WikiOasis\\WikiOasisMagic\\HookHandlers\\Main::factory",
			"services": [
				"MainConfig",
				"ConfigFactory",
				"CommentStore",
				"DBLoadBalancerFactory",
				"HttpRequestFactory"
			]
		},
		"CloudflarePurge": {
			"class": "WikiOasis\\WikiOasisMagic\\HookHandlers\\CloudflarePurge",
			"services": [
				"MainConfig"
			]
		},
		"RequestWiki": {
			"class": "WikiOasis\\WikiOasisMagic\\HookHandlers\\RequestWiki"
		}
	},
	"config": {
		"WikiOasisMagicMemcachedServers": {
			"description": "Array. Memcached servers to use for clearing memcached keys when a wiki is deleted or renamed.",
			"value": []
		},
        "WikiOasisMagicReportsBlockAlertKeywords": {
          "description": "Array. Words in block reasons which trigger a report being sent to TSPortal.",
          "value": []
        },
        "WikiOasisMagicReportsWriteKey": {
          "description": "String. TSPortal write key to be used when connecting to it.",
          "value": ""
        },
		"WikiOasisMagicCloudflareAPIToken": {
			"description": "Cloudflare API Token used for cache purging.",
			"public": false,
			"value": ""
		},
		"WikiOasisMagicCloudflareZoneID": {
			"description": "Cloudflare Zone ID for this wiki's domain.",
			"public": false,
			"value": ""
		}
	},
	"JobClasses": {
		"cloudflarePagePurge": {
			"class": "WikiOasis\\WikiOasisMagic\\Jobs\\CloudflarePurgeJob",
			"needsPage": false
		}
	},
	"ServiceWiringFiles": [
		"ServiceWiring.php"
	],
	"ConfigRegistry": {
		"WikiOasisMagic": "MediaWiki\\Config\\GlobalVarConfig::newInstance"
	},
	"load_composer_autoloader": true,
	"manifest_version": 2
}