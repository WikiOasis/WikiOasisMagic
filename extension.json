	"HookHandlers": {
		"Main": {
			"class": "WikiOasis\\WikiOasisMagic\\HookHandlers\\Main",
			"factory": "WikiOasis\\WikiOasisMagic\\HookHandlers\\Main::factory",
			"services": [
				"MainConfig",
				"ConfigFactory",
				"CommentStore",
				"DBLoadBalancerFactory",
				"HttpRequestFactory"
			]
		},
		"CloudflarePurge": {
			"class": "WikiOasis\\WikiOasisMagic\\HookHandlers\\CloudflarePurge",
			"services": [
				"MainConfig",
				"HttpRequestFactory"
			]
		},
		"RequestWiki": {
			"class": "WikiOasis\\WikiOasisMagic\\HookHandlers\\RequestWiki"
		},
		"Onboarding": {
			"class": "WikiOasis\\WikiOasisMagic\\HookHandlers\\Onboarding",
			"services": [
				"WikiOasisMagic.OnboardingEnvironment",
				"WikiOasisMagic.ExperimentManager",
				"WikiOasisMagic.ExperimentTracker",
				"WikiOasisMagic.OnboardingMetrics",
				"WikiOasisMagic.OnboardingSurveyLoader",
				"UserEditTracker",
				"UserFactory",
				"HookContainer"
			]
		},
		"Experiments": {
			"class": "WikiOasis\\WikiOasisMagic\\HookHandlers\\Experiments",
			"services": [
				"WikiOasisMagic.ExperimentTracker",
				"WikiOasisMagic.WikiRollout"
			]
		}
	},
	"SpecialPages": {
		"Welcome": {
			"class": "WikiOasis\\WikiOasisMagic\\Specials\\SpecialWelcome",
			"services": [
				"WikiOasisMagic.OnboardingEnvironment",
				"WikiOasisMagic.ExperimentManager",
				"WikiOasisMagic.OnboardingMetrics",
				"WikiOasisMagic.OnboardingSurveyLoader",
				"WikiOasisMagic.OnboardingSurveyResponses",
				"WikiOasisMagic.OnboardingIcons",
				"LanguageNameUtils",
				"LanguageFallback",
				"LinkBatchFactory"
			]
		},
		"Experiments": {
			"class": "WikiOasis\\WikiOasisMagic\\Specials\\SpecialExperiments",
			"services": [
				"WikiOasisMagic.ExperimentManager",
				"WikiOasisMagic.ExperimentPresenter",
				"WikiOasisMagic.ExperimentStateStore",
				"WikiOasisMagic.ExperimentDataStore",
				"WikiOasisMagic.WikiFarm"
			]
		}
	},
	"APIModules": {
		"wikioasisonboarding": {
			"class": "WikiOasis\\WikiOasisMagic\\Api\\ApiWikiOasisOnboarding",
			"services": [
				"WikiOasisMagic.OnboardingEnvironment",
				"WikiOasisMagic.ExperimentManager",
				"WikiOasisMagic.OnboardingMetrics",
				"WikiOasisMagic.OnboardingSurveyLoader",
				"WikiOasisMagic.OnboardingSurveyResponses"
			]
		},
		"wikioasisexperiments": {
			"class": "WikiOasis\\WikiOasisMagic\\Api\\ApiExperiments",
			"services": [
				"WikiOasisMagic.ExperimentManager",
				"WikiOasisMagic.ExperimentPresenter"
			]
		},
		"wikioasisexperimentsave": {
			"class": "WikiOasis\\WikiOasisMagic\\Api\\ApiExperimentSave",
			"services": [
				"WikiOasisMagic.ExperimentManager",
				"WikiOasisMagic.ExperimentAdmin",
				"WikiOasisMagic.ExperimentPresenter",
				"WikiOasisMagic.WikiFarm"
			]
		}
	},
	"AvailableRights": [
		"experiments-manage"
	],
	"LogTypes": [
		"experiment"
	],
	"LogNames": {
		"experiment": "log-name-experiment"
	},
	"LogHeaders": {
		"experiment": "log-description-experiment"
	},
	"LogActionsHandlers": {
		"experiment/*": "MediaWiki\\Logging\\LogFormatter"
	},
	"LogRestrictions": {
		"experiment": "experiments-manage"
	},
	"ActionFilteredLogs": {
		"experiment": {
			"update": [
				"update"
			],
			"reset": [
				"reset"
			]
		}
	},
	"RateLimits": {
		"wikioasisonboarding-event": {
			"user": [
				120,
				60
			],
			"newbie": [
				120,
				60
			]
		},
		"wikioasisonboarding-submit": {
			"user": [
				10,
				3600
			],
			"newbie": [
				10,
				3600
			]
		}
	},
	"DefaultUserOptions": {
		"wikioasismagic-onboarding": ""
	},
	"DatabaseVirtualDomains": [
		"virtual-wikioasismagic"
	],
